#include <stdio.h>

int main() {
    int n, val, i;
    printf("Enter size: ");
    scanf("%d", &n);

    int arr[n + 1];
    printf("Enter sorted elements:\n");
    for (i = 0; i < n; i++) scanf("%d", &arr[i]);

    printf("Enter value to insert: ");
    scanf("%d", &val);

    for (i = n - 1; (i >= 0 && arr[i] > val); i--) {
        arr[i + 1] = arr[i];
    }
    arr[i + 1] = val;

    printf("Updated array: ");
    for (i = 0; i <= n; i++) printf("%d ", arr[i]);
    printf("\n");

    return 0;
}
