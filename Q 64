#include <stdio.h>

int main() {
    int n, freq[10] = {0};
    printf("Enter integer: ");
    scanf("%d", &n);

    if (n < 0) n = -n;

    while (n > 0) {
        freq[n % 10]++;
        n /= 10;
    }

    int max_digit = 0;
    for (int i = 1; i < 10; i++) {
        if (freq[i] > freq[max_digit]) max_digit = i;
    }

    printf("Most frequent digit: %d\n", max_digit);
    return 0;
}
