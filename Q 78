#include <stdio.h>

int main() {
    int n, sum = 0, val;
    printf("Enter n: ");
    scanf("%d", &n);

    printf("Enter elements:\n");
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &val);
            if (i == j) sum += val;
        }
    }

    printf("Main diagonal sum = %d\n", sum);
    return 0;
}
