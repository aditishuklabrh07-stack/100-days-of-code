#include <stdio.h>

int main() {
    int n;
    unsigned long long product = 1;
    printf("Enter n: ");
    scanf("%d", &n);

    int has_even = 0;
    for (int i = 2; i <= n; i += 2) {
        product *= i;
        has_even = 1;
    }

    if (has_even)
        printf("Product = %llu\n", product);
    else
        printf("No even numbers in range.\n");

    return 0;
}
