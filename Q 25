#include <stdio.h>

int main()
{
    int a, b;
    char op;

    printf("Enter expression: ");
    scanf("%d %c %d", &a, &op, &b);

    switch(op)
    {
        case '+':
            printf("Result = %d", a + b);
            break;

        case '-':
            printf("Result = %d", a - b);
            break;

        case '*':
            printf("Result = %d", a * b);
            break;

        case '/':
            if(b != 0)
                printf("Result = %d", a / b);
            else
                printf("Division by zero not possible");
            break;

        case '%':
            if(b != 0)
                printf("Result = %d", a % b);
            else
                printf("Modulo by zero not possible");
            break;

        default:
            printf("Invalid operator");
    }

    return 0;
}
