
#include <stdio.h>

int main()
{
    char s[100];
    int i, j;

    printf("Enter a string: ");
    scanf(" %[^\n]", s);

    for(i=0; s[i]!='\0'; i++)
    {
        if(s[i]=='A'||s[i]=='E'||s[i]=='I'||s[i]=='O'||s[i]=='U'||
           s[i]=='a'||s[i]=='e'||s[i]=='i'||s[i]=='o'||s[i]=='u')
        {
            for(j=i; s[j]!='\0'; j++)
            {
                s[j]=s[j+1];
            }

            i--;
        }
    }

    printf("String after removing vowels: %s", s);

    return 0;
}
