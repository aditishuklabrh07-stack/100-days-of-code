
#include <stdio.h>

int main()
{
    int n, k, i, j;
    int sum, max;

    printf("Enter size: ");
    scanf("%d", &n);

    int arr[n];

    printf("Enter elements: ");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    printf("Enter k: ");
    scanf("%d", &k);

    max = arr[0];

    for(i = 0; i <= n-k; i++)
    {
        sum = 0;

        for(j = i; j < i+k; j++)
        {
            sum = sum + arr[j];
        }

        if(sum > max || i == 0)
        {
            max = sum;
        }
    }

    printf("%d", max);

    return 0;
}
