#include <stdio.h>

int main()
{
    char date[20];
    int i;

    printf("Enter date: ");
    scanf("%s", date);

    for(i = 0; date[i] != '/'; i++)
    {
        printf("%c", date[i]);
    }

    printf("-Apr-");

    for(i = 6; date[i] != '\0'; i++)
    {
        printf("%c", date[i]);
    }

    return 0;
}
