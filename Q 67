#include <stdio.h>

int main() {
    int n, pos, val;
    printf("Enter size: ");
    scanf("%d", &n);

    int arr[n + 1];
    printf("Enter elements:\n");
    for (int i = 0; i < n; i++) scanf("%d", &arr[i]);

    printf("Enter position (0-based) and value: ");
    scanf("%d %d", &pos, &val);

    for (int i = n; i > pos; i--) arr[i] = arr[i - 1];
    arr[pos] = val;

    printf("Updated array: ");
    for (int i = 0; i <= n; i++) printf("%d ", arr[i]);
    printf("\n");

    return 0;
}
