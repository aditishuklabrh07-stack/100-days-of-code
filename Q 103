
#include <stdio.h>

int main()
{
    int n, i, j;
    int total = 0, left = 0;
    int right;

    printf("Enter size: ");
    scanf("%d", &n);

    int arr[n];

    printf("Enter elements: ");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
        total = total + arr[i];
    }

    for(i = 0; i < n; i++)
    {
        right = total - left - arr[i];

        if(left == right)
        {
            printf("%d", i);
            return 0;
        }

        left = left + arr[i];
    }

    printf("-1");

    return 0;
}
