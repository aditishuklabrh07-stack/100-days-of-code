
#include <stdio.h>

int main()
{
    char s[100];
    int i, j;

    printf("Enter a string: ");
    scanf("%s", s);

    for(i=0; s[i]!='\0'; i++)
    {
        for(j=i+1; s[j]!='\0'; j++)
        {
            if(s[i]==s[j] && s[i]>='a' && s[i]<='z')
            {
                printf("First repeating character: %c", s[i]);
                return 0;
            }
        }
    }

    printf("No repeating lowercase alphabet found");

    return 0;
}
