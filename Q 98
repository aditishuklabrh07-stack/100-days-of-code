#include <stdio.h>

int main()
{
    char s[100];
    int i;

    printf("Enter your name: ");
    scanf("%[^\n]", s);

    printf("%c. ", s[0]);

    for(i = 0; s[i] != '\0'; i++)
    {
        if(s[i] == ' ' && s[i+1] != '\0')
        {
            if(s[i+1] == ' ')
                continue;

            int j = i + 1;

            while(s[j] != ' ' && s[j] != '\0')
                j++;

            if(s[j] == '\0')
            {
                printf("%s", &s[i+1]);
            }
            else
            {
                printf("%c. ", s[i+1]);
            }
        }
    }

    return 0;
}
