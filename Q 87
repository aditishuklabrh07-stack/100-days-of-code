
#include <stdio.h>

int main()
{
    char s[100];
    int i, spaces=0, digits=0, special=0;

    printf("Enter a string: ");
    scanf(" %[^\n]", s);

    for(i=0; s[i]!='\0'; i++)
    {
        if(s[i]==' ')
        {
            spaces++;
        }
        else if(s[i]>='0' && s[i]<='9')
        {
            digits++;
        }
        else if((s[i]>='a' && s[i]<='z') || (s[i]>='A' && s[i]<='Z'))
        {
            continue;
        }
        else
        {
            special++;
        }
    }

    printf("Spaces = %d\n", spaces);
    printf("Digits = %d\n", digits);
    printf("Special characters = %d\n", special);

    return 0;
}
