#include <stdio.h>

int main()
{
    char s[100];
    int i, count = 0, max = 0;
    int start, maxstart;

    printf("Enter a sentence: ");
    scanf(" %[^\n]", s);

    for(i = 0; ; i++)
    {
        if(s[i] != ' ' && s[i] != '\0')
        {
            count++;
        }
        else
        {
            if(count > max)
            {
                max = count;
                maxstart = i - count;
            }

            count = 0;

            if(s[i] == '\0')
                break;
        }
    }

    printf("Longest word: ");

    for(i = maxstart; i < maxstart + max; i++)
    {
        printf("%c", s[i]);
    }

    return 0;
}
