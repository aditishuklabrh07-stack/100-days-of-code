
#include <stdio.h>

int main()
{
    char s1[100], s2[100];
    int i, j, l1=0, l2=0, found;

    printf("Enter first string: ");
    scanf("%s", s1);

    printf("Enter second string: ");
    scanf("%s", s2);

    for(i=0; s1[i]!='\0'; i++)
        l1++;

    for(i=0; s2[i]!='\0'; i++)
        l2++;

    if(l1!=l2)
    {
        printf("Not Anagrams");
        return 0;
    }

    for(i=0; s1[i]!='\0'; i++)
    {
        found=0;

        for(j=0; s2[j]!='\0'; j++)
        {
            if(s1[i]==s2[j])
            {
                found=1;
                s2[j]='0';
                break;
            }
        }

        if(found==0)
        {
            printf("Not Anagrams");
            return 0;
        }
    }

    printf("Anagrams");

    return 0;
}
